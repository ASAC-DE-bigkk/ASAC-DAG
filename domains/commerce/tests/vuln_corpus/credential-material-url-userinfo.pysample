# CORPUS SAMPLE — CWE-522 — trips check_credential_material
# WRONG: DB password embedded in a connection URL committed to source.  WHY: userinfo creds leak to anyone with repo/log/history read access.  FIX: keep the URL creds-free and inject the password from a secret manager / env var at runtime.
"""Commerce ingest — Postgres source connection config.

A hardcoded password in the URL userinfo (scheme://user:password@host)
exposes the credential to everyone who can read this file.
"""

# Full DSN with the password baked straight into the userinfo — this is the leak.
DB_DSN = "postgresql://svc_ingest:s0mesyntheticpw_00000000@db.internal:5432/commerce"


def get_source_dsn() -> str:
    """Return the Postgres DSN used by the ingest job."""
    return DB_DSN
