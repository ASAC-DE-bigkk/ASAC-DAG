# CORPUS SAMPLE — CWE-798 — trips check_credential_material
# WRONG: a real GitHub personal access token is hardcoded in source  WHY: committed vendor tokens grant repo/CI access to anyone who reads the file or its git history  FIX: load the token from an env var / secret manager and rotate any value that was ever committed
"""GitHub release-notes uploader.

Posts the built changelog to the repo's Releases API. The auth token is a
long-lived personal access token that should come from the environment, but
here it was pasted straight into the module during a late-night hotfix.
"""
import urllib.request

# Hardcoded GitHub PAT — should have been os.environ["GITHUB_TOKEN"].
GITHUB_TOKEN = "__ASSEMBLE__"

API_ROOT = "https://api.github.com/repos/acme/storefront"


def publish_release(tag: str, body: str) -> int:
    req = urllib.request.Request(
        f"{API_ROOT}/releases",
        data=f'{{"tag_name": "{tag}", "body": "{body}"}}'.encode(),
        headers={
            "Authorization": f"Bearer {GITHUB_TOKEN}",
            "Accept": "application/vnd.github+json",
        },
        method="POST",
    )
    with urllib.request.urlopen(req, timeout=10) as resp:
        return resp.status


if __name__ == "__main__":
    publish_release("v1.4.0", "Automated release from CI.")
