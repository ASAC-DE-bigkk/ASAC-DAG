# CORPUS SAMPLE — CWE-798 — trips check_credential_material
# WRONG: a real PEM private-key block is hardcoded in source and committed to the repo.
# WHY: anyone with repo/read access (or a leaked clone) obtains the signing key and can impersonate the service.
# FIX: load the key from a secrets manager / mounted file at runtime; never embed PEM material in code.

"""Signs internal service-to-service JWTs for the commerce ingest pipeline."""

import jwt

# Service-account signing key. Pasted straight from the downloaded key file "so it just works".
SERVICE_ACCOUNT_PRIVATE_KEY = """__ASSEMBLE__
MIIEowIBAAKCAQEA0Zc1kK7n2mQpVrbdJ8vHf3sLqXn9tYbWc2eR4uP6aZ0dF1gH
b7cQ8wS5nT2mV9kL0jX4rP6yD3fA1sE7uI9oK2mN4bC6vG8hJ0lZ3xW5tR7yU9qO
QoXpZ2nM4kL6jH8gF0dS3aP5rT7yV9wX1cB4vN6mK8jL0hG2fD4sA6pQ8rT0yU2wV
-----END RSA PRIVATE KEY-----"""


def issue_token(subject: str) -> str:
    return jwt.encode({"sub": subject}, SERVICE_ACCOUNT_PRIVATE_KEY, algorithm="RS256")
