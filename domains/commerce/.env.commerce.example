# ─────────────────────────────────────────────────────────────────────────────
# .env.commerce — commerce 카테고리 전용 런타임 환경변수 (템플릿)
#
# 이 파일은 dags/domains/commerce/ 번들 안에서 자립한다. DAG 가 임포트될 때
# include/common/env.py 의 load_commerce_env() 가 이 폴더의 .env.commerce 를 읽어
# os.environ 에 **채운다(setdefault)**. 즉 이미 프로세스 환경(루트 .env / compose
# environment:)에 있는 값이 우선이고, 없는 commerce 전용 값만 이 파일이 채운다.
#
# 사용법:
#   cp .env.commerce.example .env.commerce   (또는 Copy-Item)
#   빈 값을 채운다. 서울 API 인증키는 루트 .env 의 SEOUL_API_KEY_COMM(#70). .env.commerce 는 gitignore 됨(시크릿).
#
# 우선순위(높음 → 낮음): 프로세스 env(루트 .env/compose) > .env.commerce > settings.py 기본값
# 경로 override: COMMERCE_ENV_FILE 로 다른 파일을 지정할 수 있다.
# 참조 코드: include/common/settings.py · include/common/env.py · include/common/registry.py
# ─────────────────────────────────────────────────────────────────────────────

# ── 서울 열린데이터광장 OpenAPI (필수) ──────────────────────────────────────
# 인증키는 루트 .env 의 SEOUL_API_KEY_COMM 으로 이관됨(#70).
# SEOUL_PAGE_SIZE: 1회 조회 건수(서울 상한 1000으로 캡).
SEOUL_PAGE_SIZE=1000
# SEOUL_MAX_PAGES: 페이지 수 제한. **비우면(미설정) 무제한 — 끝까지 순회**.
# 일반 API 는 호출 횟수 제한이 없으므로 기본 무제한. 양수만 부분 수집(개발용) 캡.
SEOUL_MAX_PAGES=
SEOUL_REQUEST_DELAY_SECONDS=0.2

# ── 스토리지 백엔드 ─────────────────────────────────────────────────────────
# local = 컨테이너 로컬 볼륨(클라우드 자격증명 불필요) | r2 = Cloudflare R2(boto3 사용·이미지 기본 포함)
STORAGE_BACKEND=local
LOCAL_DATA_ROOT=/opt/airflow/data
# bucket 아래 공통 접두(예: dev/<github_id>). 비우면 {bucket}/raw/commerce/...
COMMERCE_STORAGE_PREFIX=
# 레이어 접두(스테이지/도메인) — bronze→raw 리네임 반영(.env 로 관리).
# 기본값 그대로면 raw/commerce · silver/commerce. 데이터가 raw/commerce 로 이관됨.
COMMERCE_RAW_LAYER=raw/commerce
COMMERCE_SILVER_LAYER=silver/commerce
# raw 마커(리니지) JSON 의 schema_version
SCHEMA_VERSION=v1

# ── Cloudflare R2 (STORAGE_BACKEND=r2 일 때만 필요) ──────────────────────────
# 루트 .env 와 겹치는 값은 ${...} 로 불러온다(로더가 프로세스 env = 루트 .env 로 치환).
# 중복 저장하지 않으며, 이름이 다른 것만 매핑한다(R2_BUCKET ← 루트 R2_DEV_BUCKET_NAME).
# ※ settings.py 는 R2_BUCKET 을 읽는다(루트 .env 의 R2_BUCKET_NAME 과 이름이 다름).
# 루트 .env 에 해당 키가 없다면 ${VAR:-기본값} 또는 실제 값으로 바꿔 넣는다.
R2_ENDPOINT=${R2_DEV_ENDPOINT}
R2_BUCKET=${R2_DEV_BUCKET_NAME:-seoul-dev}
R2_ACCESS_KEY_ID=${R2_DEV_ACCESS_KEY_ID}
R2_SECRET_ACCESS_KEY=${R2_DEV_SECRET_ACCESS_KEY}
R2_REGION=auto

# ── Iceberg bronze 적재 (commerce_load_bronze DAG) ──────────────────────────
# raw 증분(row-NDJSON)을 Iceberg bronze 테이블(<catalog>.<schema>.bronze_localdata_license)에 적재.
# 엔진: 전체 스냅샷(mode=first) → PyIceberg(대용량 커밋 1회), 소량 변경분 → Trino 증분.
# 값이 이미 프로세스 env(루트 .env/compose)에 있으면 그것이 우선 — 중복 저장 안 함.
# bronze 스키마명(신설). 기본 commerce.
COMMERCE_SCHEMA=commerce
# 적재 상태(워터마크·pending·receipt) 저장 레이어 — **raw 와 격리**된 top-level(commerce_ prefix).
COMMERCE_BRONZE_STATE_LAYER=commerce_bronze_state
# 실행당 적재할 최대 날짜 수(0=무제한). backfill 은 재실행이 catch-up.
COMMERCE_LOAD_MAX_DATES=3
# Trino 접속(형제 dbt 라인과 동일 계약). DBT_TARGET=dev 면 iceberg_dev(seoul-dev), prod 면 iceberg(seoul).
# TRINO_HOST=trino
# TRINO_PORT=8080
# TRINO_USER=airflow
# TRINO_HTTP_SCHEME=http
# TRINO_DEV_ICEBERG_CATALOG=iceberg_dev
# TRINO_ICEBERG_CATALOG=iceberg
# DBT_TARGET=dev
# PyIceberg 전체 적재용 R2 Data Catalog(REST) — 루트 .env 의 값 사용(dev 는 R2_DEV_* 우선).
# R2_DEV_DATA_CATALOG_URI / R2_DEV_DATA_CATALOG_TOKEN / R2_DEV_DATA_CATALOG_WAREHOUSE (dev)
# R2_DATA_CATALOG_URI / R2_DATA_CATALOG_TOKEN / R2_DATA_CATALOG_WAREHOUSE (prod)

# ── dbt silver 변환 (commerce_localdata_transform DAG) ──────────────────────
# dbt 프로젝트 경로(컨테이너 기준)와 타깃. DBT_BIN 은 호스트 이미지가 제공
# (/home/airflow/dbt-venv/bin/dbt). COMMERCE_DBT_TARGET 이 DBT_TARGET 보다 우선.
# COMMERCE_DBT_PROJECT_DIR=/opt/airflow/dbt/domains/commerce
# COMMERCE_DBT_TARGET=dev

# ── 선택 ────────────────────────────────────────────────────────────────────
# 데이터셋 레지스트리 경로 override(기본: 이 번들의 config/dataset_registry.yaml)
# COMMERCE_REGISTRY_PATH=

# ── Juso(도로명주소) API — silver 지번 결측 보강(enrich_fill_jibun 태스크) ──
# 발급: https://business.juso.go.kr (검색 API 승인키). *_KEY 네이밍 — 자동 마스킹 대상.
# JUSO_CONFM_KEY=
# JUSO_API_URL=https://business.juso.go.kr/addrlink/addrLinkApi.do
# JUSO_REQUEST_DELAY_SECONDS=0.15
# 1회 실행당 신규 조회 주소 상한(빈값/0=무제한). 개발/검증용 캡.
# JUSO_MAX_ADDRESSES=

# ── 알림(성공/완료·예외) — commerce_core.notify ──
# URL 설정 시 WebhookNotifier 활성(미설정=no-op). URL 은 토큰 포함 시크릿 취급(자동 마스킹 등록).
# 지번 보강(enrich_fill_jibun)의 처리 결과·미해결 주소가 이 채널로 전송된다.
# COMMERCE_NOTIFY_WEBHOOK_URL=
# COMMERCE_NOTIFY_WEBHOOK_KIND=discord   # discord | generic(JSON)
